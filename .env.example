# 环境变量的示例文件

# 两个可选值：
# 1. fake 使用模拟模型
# 2. ark 使用真实模型
TEXT_MODEL_PROVIDER=

# 火山引擎里面申请的 api key
ARK_API_KEY=

# 文本模式
ARK_MODEL=

# =============================================================================
# 多项目端口配置（docker-compose 使用）
# =============================================================================
# 用法：
#   1) 复制本文件为 .env（实际使用）；.env 含密钥，不要提交进仓库。
#   2) 每个项目在各自根目录维护一份 .env，端口整体错开即可多实例共存。
#   3) 项目名决定 容器名/网络/卷 前缀，各项目必须不同。
#
# 项目名（docker compose --project-name 优先于本变量）
COMPOSE_PROJECT_NAME=ai-comic-drama

# ---- 宿主端口（默认值与 docker-compose.yml 一致）----
# langfuse-web 入口
LANGFUSE_WEB_PORT=3000
# langfuse-minio 对象存储 API
LANGFUSE_MINIO_API_PORT=9000
# langfuse-minio 管理控制台
LANGFUSE_MINIO_CONSOLE_PORT=9001
# litellm 网关
LITELLM_PORT=4000
# nacos 控制台（已绑定 127.0.0.1）
NACOS_CONSOLE_PORT=8080
# nacos HTTP 客户端 API（已绑定 127.0.0.1）
NACOS_HTTP_PORT=8848
# nacos gRPC 客户端通信（已绑定 127.0.0.1）
NACOS_GRPC_PORT=9848
# opensandbox-server（已绑定 127.0.0.1）
OPEN_SANDBOX_PORT=8090
# shared-minio 对象存储 API
SHARED_MINIO_API_PORT=9002
# shared-minio 管理控制台
SHARED_MINIO_CONSOLE_PORT=9003

# 第二个项目整体错开的示例（写进项目 B 自己的 .env）：
#   COMPOSE_PROJECT_NAME=project-b
#   LANGFUSE_WEB_PORT=3100
#   LANGFUSE_MINIO_API_PORT=9100
#   LANGFUSE_MINIO_CONSOLE_PORT=9101
#   LITELLM_PORT=4100
#   NACOS_CONSOLE_PORT=8180
#   NACOS_HTTP_PORT=8948
#   NACOS_GRPC_PORT=9948
#   OPEN_SANDBOX_PORT=8190
#   SHARED_MINIO_API_PORT=9102
#   SHARED_MINIO_CONSOLE_PORT=9103

# 注意：
#   - .env 里凡是引用宿主地址的配置也要跟着改，例如
#     LANGFUSE_AI_BASE_URL=http://localhost:4100/v1（4100 换成你项目的 LITELLM_PORT），
#     不要写死默认端口，否则会打到别的项目实例。
#   - 容器内通信地址（服务名:端口，如 langfuse-minio:9000）永远不要改。